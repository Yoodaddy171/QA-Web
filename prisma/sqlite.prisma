generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                String             @id @default(cuid())
  workspaceId       String
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  automationContext String?
  allowExternalAi   Boolean            @default(false)
  aiMonthlyTokenBudget Int             @default(100000)
  deletionState     String             @default("ACTIVE")
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  testCases         TestCase[]
  bugFixItems       BugFix[]
  modules           Module[]
  knowledgeItems    ProjectKnowledge[]
  automationRuns    AutomationRun[]
  reports           Report[]
  testRuns          TestRun[]
  activityHistory   ActivityHistory[]
  requirements      Requirement[]
  testPlans         TestPlan[]
  notifications     Notification[]
  aiRequestAudits   AiRequestAudit[]
  aiUsageMonths     AiUsageMonth[]

  @@index([updatedAt])
  @@index([workspaceId, updatedAt])
}

model User {
  id           String                @id @default(cuid())
  email        String                @unique
  name         String
  passwordHash String
  disabledAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  memberships WorkspaceMembership[]
  sessions     Session[]
  activities   ActivityHistory[]
  aiRequests   AiRequestAudit[]
}

model AiRequestAudit {
  id             String   @id @default(cuid())
  projectId      String
  actorUserId    String?
  operation      String
  promptVersion  String
  provider       String
  model          String
  contextIds     Json?
  dataCategories Json?
  inputChars     Int
  outputChars    Int
  inputTokens    Int
  outputTokens   Int
  outputHash     String?
  status         String
  errorCode      String?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUser      User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([projectId, provider, status])
  @@map("AIRequestAudit")
}

model AiUsageMonth {
  id           String   @id @default(cuid())
  projectId    String
  month        String
  usedTokens   Int      @default(0)
  requestCount Int      @default(0)
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month])
  @@index([month, updatedAt])
  @@map("AIUsageMonth")
}

model Workspace {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  projects    Project[]
  memberships WorkspaceMembership[]
}

model WorkspaceMembership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("VIEWER")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, role])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model ProjectKnowledge {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, type])
}

model Module {
  id          String      @id @default(cuid())
  name        String
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  testCases   TestCase[]
  bugFixItems BugFix[]

  @@index([projectId, updatedAt])
}

model TestCase {
  id             String   @id @default(cuid())
  testCaseId     String
  page           String
  subMenu        String?
  weight         String?
  testType       String
  testAction     String
  steps          String
  stepLogs       String?
  expectedResult String
  actualResult   String?
  status         String   @default("NOT DONE")
  progress       Int      @default(0)
  remarks        String?
  tags           String?
  priority       String   @default("Medium")
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId       String?
  module         Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bugFixItems    BugFix[]
  testRunCases   TestRunCase[]
  testExecutions TestExecution[]
  requirementLinks RequirementTestCase[]

  @@unique([projectId, testCaseId])
  @@index([projectId, moduleId, status])
  @@index([projectId, updatedAt])
}

model TestRun {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      String          @default("DRAFT")
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String?
  assignedTo  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testPlanId  String?
  testPlan    TestPlan?       @relation(fields: [testPlanId], references: [id], onDelete: SetNull)
  testCases   TestRunCase[]
  executions  TestExecution[]
  reports     Report[]

  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

model Requirement {
  id          String                 @id @default(cuid())
  projectId   String
  key         String
  title       String
  description String?
  status      String                 @default("DRAFT")
  priority    String                 @default("Medium")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testPlans   TestPlanRequirement[]
  testCases   RequirementTestCase[]

  @@unique([projectId, key])
  @@index([projectId, status])
}

model TestPlan {
  id           String                 @id @default(cuid())
  projectId    String
  name         String
  description  String?
  status       String                 @default("DRAFT")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements TestPlanRequirement[]
  testRuns     TestRun[]

  @@index([projectId, status])
}

model TestPlanRequirement {
  id            String      @id @default(cuid())
  testPlanId    String
  requirementId String
  createdAt     DateTime    @default(now())
  testPlan      TestPlan    @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([testPlanId, requirementId])
  @@index([requirementId])
}

model RequirementTestCase {
  id            String      @id @default(cuid())
  requirementId String
  testCaseId    String
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCase      TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([requirementId, testCaseId])
  @@index([testCaseId])
}

model ActivityHistory {
  id          String   @id @default(cuid())
  projectId   String
  entityType  String
  entityId    String
  action      String
  field       String?
  beforeValue Json?
  afterValue  Json?
  actor       String?
  actorUserId String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model Notification {
  id           String    @id @default(cuid())
  projectId    String
  recipientKey String    @default("local-user")
  type         String
  severity     String    @default("info")
  title        String
  message      String
  entityType   String?
  entityId     String?
  metadata     Json?
  dedupeKey    String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, recipientKey, dedupeKey])
  @@index([projectId, recipientKey, readAt, createdAt])
  @@index([entityType, entityId])
}

model TestRunCase {
  id          String          @id @default(cuid())
  testRunId   String
  testCaseId  String
  assignedTo  String?
  latestStatus String         @default("NOT RUN")
  latestExecutionAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  testRun     TestRun         @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase    TestCase        @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executions  TestExecution[]

  @@unique([testRunId, testCaseId])
  @@index([testCaseId, updatedAt])
}

model TestExecution {
  id            String        @id @default(cuid())
  testRunId     String
  testCaseId    String
  testRunCaseId String?
  bugFixId      String?
  tester        String?
  status        String        @default("NOT RUN")
  actualResult  String?
  notes         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  testRun       TestRun       @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase      TestCase      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testRunCase   TestRunCase?  @relation(fields: [testRunCaseId], references: [id], onDelete: SetNull)
  bugFix        BugFix?       @relation("BugRetestExecutions", fields: [bugFixId], references: [id], onDelete: SetNull)
  evidence      TestExecutionEvidence[]
  createdBugFixes BugFix[]    @relation("BugSourceExecution")

  @@index([testRunId, status])
  @@index([testCaseId, createdAt])
  @@index([testRunCaseId, createdAt])
  @@index([bugFixId, createdAt])
}

model TestExecutionEvidence {
  id          String        @id @default(cuid())
  executionId String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  sha256      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  execution   TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}

model BugFix {
  id               String    @id @default(cuid())
  sourceTestCaseId String
  sourceExecutionId String?
  testCaseId       String
  projectId        String
  page             String
  subMenu          String?
  testType         String
  testAction       String
  steps            String
  stepLogs         String?
  expectedResult   String
  actualResult     String
  priority         String
  moduleId         String?
  status           String    @default("SUDAH DILAPORKAN")
  reportedAt       DateTime?
  fixingAt         DateTime?
  readyAt          DateTime?
  fixedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module           Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  sourceTestCase   TestCase  @relation(fields: [sourceTestCaseId], references: [id], onDelete: Cascade)
  sourceExecution  TestExecution? @relation("BugSourceExecution", fields: [sourceExecutionId], references: [id], onDelete: SetNull)
  retestExecutions TestExecution[] @relation("BugRetestExecutions")

  @@index([projectId, moduleId, status])
  @@index([projectId, updatedAt])
  @@index([sourceExecutionId])
}

model AutomationRun {
  id            String            @id @default(cuid())
  runKey        String            @unique
  externalRunId String?
  sessionId     String?
  projectId     String?
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCaseId    String
  source        String            @default("testcase")
  mode          String            @default("unknown")
  status        String            @default("running")
  startedAt     DateTime
  endedAt       DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  events        AutomationEvent[]
  recording     Recording?

  @@index([projectId, startedAt])
  @@index([testCaseId, startedAt])
  @@index([status, updatedAt])
}

model AutomationEvent {
  sequence   BigInt        @id @default(autoincrement())
  eventId    String        @unique
  runId      String
  run        AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCaseId String
  eventType  String
  timestamp  DateTime
  relativeMs Int?
  payload    Json
  createdAt  DateTime      @default(now())

  @@index([runId, sequence])
  @@index([testCaseId, sequence])
  @@index([timestamp])
}

model Recording {
  id          String        @id @default(cuid())
  recordingId String        @unique
  runId       String        @unique
  run         AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCaseId  String
  sessionId   String
  mode        String
  status      String
  targetUrl   String?
  mediaRoot   String
  metadata    Json
  startedAt   DateTime
  stoppedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([testCaseId, startedAt])
  @@index([status, updatedAt])
}

model Report {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testRunId            String?
  testRun              TestRun? @relation(fields: [testRunId], references: [id], onDelete: SetNull)
  reportType           String
  status               String   @default("DRAFT")
  documentId           String?
  version              String
  author               String?
  approvedBy           String?
  dateOfIssue          DateTime?
  documentStatus       String?
  reportingPeriodStart DateTime
  reportingPeriodEnd   DateTime
  progressNarrative    String?
  blockingFactors      String?
  newRisks             String?
  plannedTesting       String?
  metadataJson         Json?
  sectionsJson         Json?
  metricsSnapshot      Json
  finalizedAt          DateTime?
  finalizedBy          String?
  snapshotChecksum     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([reportType, createdAt])
  @@index([testRunId])
  @@unique([projectId, documentId, version])
}
