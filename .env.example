# QA-Web binds to loopback by default. Only change these values after authentication/RBAC is configured.
QA_WEB_HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000
QA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# First-owner setup. Remove these values after bootstrap succeeds.
QA_BOOTSTRAP_TOKEN=
QA_BOOTSTRAP_EMAIL=
QA_BOOTSTRAP_NAME=
QA_BOOTSTRAP_PASSWORD=
QA_BOOTSTRAP_WORKSPACE=Local Workspace
# Set to 1 only behind HTTPS.
QA_COOKIE_SECURE=0
DATABASE_URL="file:./db/custom.db"
# POSTGRES_DATABASE_URL="postgresql://qa_web:<strong-password>@127.0.0.1:5432/qa_web"
POSTGRES_PASSWORD=

# Generate a fresh pair with: npm run relay:token
# Both values must contain the same random token. Never commit the generated value.
QA_RELAY_TOKEN=
NEXT_PUBLIC_QA_RELAY_TOKEN=
QA_RELAY_HOST=127.0.0.1
QA_RELAY_PORT=3001
QA_RELAY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
QA_RELAY_ALLOW_BROWSER_LAUNCH=0
QA_EVIDENCE_PROJECT_QUOTA_MB=1024
QA_EVIDENCE_GLOBAL_QUOTA_MB=5120
QA_BACKUP_DIR=backups
QA_BACKUP_RETENTION_DAYS=30
# Runtime logs/recordings default to %LOCALAPPDATA%/web-qa-runtime on Windows.
QA_RUNTIME_DIR=
# Optional read-only fallback for installations that still keep old artifacts in the repo.
QA_LEGACY_LOGS_DIR=
QA_LEGACY_RECORDINGS_DIR=

# AI secrets are host-managed and can no longer be read or changed through HTTP.
AI_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_REQUEST_TIMEOUT_MS=30000
AI_REQUESTS_PER_MINUTE=20
AI_MAX_OUTPUT_TOKENS=4000
