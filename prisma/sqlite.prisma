generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                String             @id @default(cuid())
  name              String
  description       String?
  automationContext String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  testCases         TestCase[]
  bugFixItems       BugFix[]
  modules           Module[]
  knowledgeItems    ProjectKnowledge[]
  reports           Report[]
  testRuns          TestRun[]
  activityHistory   ActivityHistory[]
  requirements      Requirement[]
  testPlans         TestPlan[]
  notifications     Notification[]
}

model ProjectKnowledge {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Module {
  id          String      @id @default(cuid())
  name        String
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  testCases   TestCase[]
  bugFixItems BugFix[]

  @@index([projectId])
}

model TestCase {
  id             String   @id @default(cuid())
  testCaseId     String
  page           String
  subMenu        String?
  weight         String?
  testType       String
  testAction     String
  steps          String
  stepLogs       String?
  expectedResult String
  actualResult   String?
  status         String   @default("NOT DONE")
  progress       Int      @default(0)
  remarks        String?
  tags           String?
  priority       String   @default("Medium")
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId       String?
  module         Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bugFixItems    BugFix[]
  testRunCases   TestRunCase[]
  testExecutions TestExecution[]
  requirementLinks RequirementTestCase[]

  @@index([projectId, testCaseId])
  @@index([projectId, status])
  @@index([projectId, moduleId])
  @@index([projectId, page, subMenu])
  @@index([projectId, updatedAt])
}

model TestRun {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      String          @default("DRAFT")
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String?
  assignedTo  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testPlanId  String?
  testPlan    TestPlan?       @relation(fields: [testPlanId], references: [id], onDelete: SetNull)
  testCases   TestRunCase[]
  executions  TestExecution[]

  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

model Requirement {
  id          String                 @id @default(cuid())
  projectId   String
  key         String
  title       String
  description String?
  status      String                 @default("DRAFT")
  priority    String                 @default("Medium")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testPlans   TestPlanRequirement[]
  testCases   RequirementTestCase[]

  @@unique([projectId, key])
  @@index([projectId, status])
}

model TestPlan {
  id           String                 @id @default(cuid())
  projectId    String
  name         String
  description  String?
  status       String                 @default("DRAFT")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements TestPlanRequirement[]
  testRuns     TestRun[]

  @@index([projectId, status])
}

model TestPlanRequirement {
  id            String      @id @default(cuid())
  testPlanId    String
  requirementId String
  createdAt     DateTime    @default(now())
  testPlan      TestPlan    @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([testPlanId, requirementId])
  @@index([requirementId])
}

model RequirementTestCase {
  id            String      @id @default(cuid())
  requirementId String
  testCaseId    String
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCase      TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([requirementId, testCaseId])
  @@index([testCaseId])
}

model ActivityHistory {
  id          String   @id @default(cuid())
  projectId   String
  entityType  String
  entityId    String
  action      String
  field       String?
  beforeValue Json?
  afterValue  Json?
  actor       String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Notification {
  id           String    @id @default(cuid())
  projectId    String
  recipientKey String    @default("local-user")
  type         String
  severity     String    @default("info")
  title        String
  message      String
  entityType   String?
  entityId     String?
  metadata     Json?
  dedupeKey    String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, recipientKey, dedupeKey])
  @@index([projectId, recipientKey, readAt, createdAt])
  @@index([entityType, entityId])
}

model TestRunCase {
  id          String          @id @default(cuid())
  testRunId   String
  testCaseId  String
  assignedTo  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  testRun     TestRun         @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase    TestCase        @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executions  TestExecution[]

  @@unique([testRunId, testCaseId])
  @@index([testCaseId, updatedAt])
}

model TestExecution {
  id            String        @id @default(cuid())
  testRunId     String
  testCaseId    String
  testRunCaseId String?
  bugFixId      String?
  tester        String?
  status        String        @default("NOT RUN")
  actualResult  String?
  notes         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  testRun       TestRun       @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase      TestCase      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testRunCase   TestRunCase?  @relation(fields: [testRunCaseId], references: [id], onDelete: SetNull)
  bugFix        BugFix?       @relation("BugRetestExecutions", fields: [bugFixId], references: [id], onDelete: SetNull)
  evidence      TestExecutionEvidence[]
  createdBugFixes BugFix[]    @relation("BugSourceExecution")

  @@index([testRunId, status])
  @@index([testCaseId, createdAt])
  @@index([testRunCaseId, createdAt])
  @@index([bugFixId, createdAt])
}

model TestExecutionEvidence {
  id          String        @id @default(cuid())
  executionId String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  execution   TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}

model BugFix {
  id               String    @id @default(cuid())
  sourceTestCaseId String
  sourceExecutionId String?
  testCaseId       String
  projectId        String
  page             String
  subMenu          String?
  testType         String
  testAction       String
  steps            String
  stepLogs         String?
  expectedResult   String
  actualResult     String
  priority         String
  moduleId         String?
  status           String    @default("SUDAH DILAPORKAN")
  reportedAt       DateTime?
  fixingAt         DateTime?
  readyAt          DateTime?
  fixedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module           Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  sourceTestCase   TestCase  @relation(fields: [sourceTestCaseId], references: [id], onDelete: Cascade)
  sourceExecution  TestExecution? @relation("BugSourceExecution", fields: [sourceExecutionId], references: [id], onDelete: SetNull)
  retestExecutions TestExecution[] @relation("BugRetestExecutions")

  @@index([projectId, status])
  @@index([projectId, moduleId])
  @@index([sourceTestCaseId])
  @@index([sourceExecutionId])
}

model Report {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportType           String
  status               String   @default("DRAFT")
  documentId           String?
  version              String
  author               String?
  approvedBy           String?
  dateOfIssue          DateTime?
  documentStatus       String?
  reportingPeriodStart DateTime
  reportingPeriodEnd   DateTime
  progressNarrative    String?
  blockingFactors      String?
  newRisks             String?
  plannedTesting       String?
  metadataJson         Json?
  sectionsJson         Json?
  metricsSnapshot      Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([reportType, createdAt])
}
