generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                String             @id @default(cuid())
  name              String
  description       String?
  automationContext String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  testCases         TestCase[]
  bugFixItems       BugFix[]
  modules           Module[]
  knowledgeItems    ProjectKnowledge[]
  reports           Report[]
}

model ProjectKnowledge {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Module {
  id          String      @id @default(cuid())
  name        String
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  testCases   TestCase[]
  bugFixItems BugFix[]

  @@index([projectId])
}

model TestCase {
  id             String   @id @default(cuid())
  testCaseId     String
  page           String
  subMenu        String?
  weight         String?
  testType       String
  testAction     String
  steps          String
  stepLogs       String?
  expectedResult String
  actualResult   String?
  status         String   @default("NOT DONE")
  progress       Int      @default(0)
  remarks        String?
  priority       String   @default("Medium")
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId       String?
  module         Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bugFixItems    BugFix[]

  @@index([projectId, testCaseId])
  @@index([projectId, status])
  @@index([projectId, moduleId])
  @@index([projectId, page, subMenu])
  @@index([projectId, updatedAt])
}

model BugFix {
  id               String    @id @default(cuid())
  sourceTestCaseId String
  testCaseId       String
  projectId        String
  page             String
  subMenu          String?
  testType         String
  testAction       String
  steps            String
  stepLogs         String?
  expectedResult   String
  actualResult     String
  priority         String
  moduleId         String?
  status           String    @default("SUDAH DILAPORKAN")
  reportedAt       DateTime?
  fixingAt         DateTime?
  readyAt          DateTime?
  fixedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module           Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  sourceTestCase   TestCase  @relation(fields: [sourceTestCaseId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, moduleId])
  @@index([sourceTestCaseId])
}

model Report {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportType           String
  status               String   @default("DRAFT")
  documentId           String?
  version              String
  author               String?
  approvedBy           String?
  dateOfIssue          DateTime?
  documentStatus       String?
  reportingPeriodStart DateTime
  reportingPeriodEnd   DateTime
  progressNarrative    String?
  blockingFactors      String?
  newRisks             String?
  plannedTesting       String?
  metadataJson         Json?
  sectionsJson         Json?
  metricsSnapshot      Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([reportType, createdAt])
}
