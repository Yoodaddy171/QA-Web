generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/postgresql-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                String             @id @default(cuid())
  name              String
  description       String?
  automationContext String? // Object Repository info for AI
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  testCases         TestCase[]
  bugFixItems       BugFix[]
  modules           Module[]
  knowledgeItems    ProjectKnowledge[]
  automationRuns    AutomationRun[]
  testRuns          TestRun[]
  activityHistory   ActivityHistory[]
  requirements      Requirement[]
  testPlans         TestPlan[]
  reports           Report[]
  notifications     Notification[]

  @@index([updatedAt])
}

model ProjectKnowledge {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // API_DOCS, FEATURE_MAP, QA_RULES, DOMAIN_DICTIONARY, TEST_STRATEGY, CHANGELOG, KNOWN_ISSUE, ENV_NOTE
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, type])
}

model Module {
  id          String     @id @default(cuid())
  name        String
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  testCases   TestCase[]
  bugFixItems BugFix[]

  @@index([projectId, updatedAt])
}

model TestCase {
  id             String   @id @default(cuid())
  testCaseId     String // e.g. A-001, B-002
  page           String // e.g. CMS Login, Dashboard
  subMenu        String? // e.g. Order List, Product
  weight         String? // e.g. 16.60%, 6.25%
  testType       String // Positive / Negative
  testAction     String // Description of the test action
  steps          String // Test steps (multiline)
  stepLogs       String? // Console logs per step (multiline)
  expectedResult String // Expected result
  actualResult   String? // "As Expected" / "Not As Expected"
  status         String   @default("NOT DONE") // DONE, NOT DONE, IN PROGRESS, BLOCKED, FAILED, READY TO RETEST, TBA
  progress       Int      @default(0) // 0-100
  remarks        String? // Remarks / notes
  tags           String? // Comma-separated project-local tags
  priority       String   @default("Medium") // Low, Medium, High, Critical
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId       String?
  module         Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bugFixItems    BugFix[]
  testRunCases   TestRunCase[]
  testExecutions TestExecution[]
  requirementLinks RequirementTestCase[]

  @@unique([projectId, testCaseId])
  @@index([projectId, moduleId, status])
  @@index([projectId, updatedAt])
}

model TestRun {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      String          @default("DRAFT")
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String?
  assignedTo  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testPlanId  String?
  testPlan    TestPlan?       @relation(fields: [testPlanId], references: [id], onDelete: SetNull)
  testCases   TestRunCase[]
  executions  TestExecution[]

  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

model Requirement {
  id          String                 @id @default(cuid())
  projectId   String
  key         String
  title       String
  description String?
  status      String                 @default("DRAFT")
  priority    String                 @default("Medium")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testPlans   TestPlanRequirement[]
  testCases   RequirementTestCase[]

  @@unique([projectId, key])
  @@index([projectId, status])
}

model TestPlan {
  id           String                 @id @default(cuid())
  projectId    String
  name         String
  description  String?
  status       String                 @default("DRAFT")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements TestPlanRequirement[]
  testRuns     TestRun[]

  @@index([projectId, status])
}

model TestPlanRequirement {
  id            String      @id @default(cuid())
  testPlanId    String
  requirementId String
  createdAt     DateTime    @default(now())
  testPlan      TestPlan    @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([testPlanId, requirementId])
  @@index([requirementId])
}

model RequirementTestCase {
  id            String      @id @default(cuid())
  requirementId String
  testCaseId    String
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCase      TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([requirementId, testCaseId])
  @@index([testCaseId])
}

model ActivityHistory {
  id         String   @id @default(cuid())
  projectId  String
  entityType String
  entityId   String
  action     String
  field      String?
  beforeValue Json?
  afterValue  Json?
  actor      String?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Notification {
  id           String    @id @default(cuid())
  projectId    String
  recipientKey String    @default("local-user")
  type         String
  severity     String    @default("info")
  title        String
  message      String
  entityType   String?
  entityId     String?
  metadata     Json?
  dedupeKey    String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, recipientKey, dedupeKey])
  @@index([projectId, recipientKey, readAt, createdAt])
  @@index([entityType, entityId])
}

model TestRunCase {
  id          String          @id @default(cuid())
  testRunId   String
  testCaseId  String
  assignedTo  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  testRun     TestRun         @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase    TestCase        @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executions  TestExecution[]

  @@unique([testRunId, testCaseId])
  @@index([testCaseId, updatedAt])
}

model TestExecution {
  id            String        @id @default(cuid())
  testRunId     String
  testCaseId    String
  testRunCaseId String?
  bugFixId      String?
  tester        String?
  status        String        @default("NOT RUN")
  actualResult  String?
  notes         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  testRun       TestRun       @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase      TestCase      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testRunCase   TestRunCase?  @relation(fields: [testRunCaseId], references: [id], onDelete: SetNull)
  bugFix        BugFix?       @relation("BugRetestExecutions", fields: [bugFixId], references: [id], onDelete: SetNull)
  evidence      TestExecutionEvidence[]
  createdBugFixes BugFix[]    @relation("BugSourceExecution")

  @@index([testRunId, status])
  @@index([testCaseId, createdAt])
  @@index([testRunCaseId, createdAt])
  @@index([bugFixId, createdAt])
}

model TestExecutionEvidence {
  id          String        @id @default(cuid())
  executionId String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  execution   TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}

model BugFix {
  id               String    @id @default(cuid())
  sourceTestCaseId String // ID of original TestCase
  sourceExecutionId String? // Execution yang memicu bug dari Test Run
  testCaseId       String // TC-ID of original test case
  projectId        String
  page             String
  subMenu          String?
  testType         String
  testAction       String
  steps            String
  stepLogs         String?
  expectedResult   String
  actualResult     String // Always "Not As Expected" for bug fix items
  priority         String
  moduleId         String?
  status           String    @default("SUDAH DILAPORKAN") // SUDAH DILAPORKAN, SEDANG DI FIX, READY TO RETEST, VERIFIED & FIXED
  reportedAt       DateTime? // timestamp when reported
  fixingAt         DateTime? // timestamp when developer starts fixing
  readyAt          DateTime? // timestamp when ready to retest
  fixedAt          DateTime? // timestamp when verified and fixed
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module         Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  sourceTestCase TestCase @relation(fields: [sourceTestCaseId], references: [id], onDelete: Cascade)
  sourceExecution TestExecution? @relation("BugSourceExecution", fields: [sourceExecutionId], references: [id], onDelete: SetNull)
  retestExecutions TestExecution[] @relation("BugRetestExecutions")

  @@index([projectId, moduleId, status])
  @@index([projectId, updatedAt])
  @@index([sourceExecutionId])
}

model AutomationRun {
  id            String            @id @default(cuid())
  runKey        String            @unique
  externalRunId String?
  sessionId     String?
  projectId     String?
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCaseId    String
  source        String            @default("testcase")
  mode          String            @default("unknown")
  status        String            @default("running")
  startedAt     DateTime
  endedAt       DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  events        AutomationEvent[]
  recording     Recording?

  @@index([projectId, startedAt])
  @@index([testCaseId, startedAt])
  @@index([status, updatedAt])
}

model AutomationEvent {
  sequence   BigInt        @id @default(autoincrement())
  eventId    String        @unique
  runId      String
  run        AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCaseId String
  eventType  String
  timestamp  DateTime
  relativeMs Int?
  payload    Json
  createdAt  DateTime      @default(now())

  @@index([runId, sequence])
  @@index([testCaseId, sequence])
  @@index([timestamp])
}

model Recording {
  id          String        @id @default(cuid())
  recordingId String        @unique
  runId       String        @unique
  run         AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCaseId  String
  sessionId   String
  mode        String
  status      String
  targetUrl   String?
  mediaRoot   String
  metadata    Json
  startedAt   DateTime
  stoppedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([testCaseId, startedAt])
  @@index([status, updatedAt])
}

model Report {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportType           String // TEST_STATUS_REPORT, TEST_PLANNING_DOCUMENT
  status               String   @default("DRAFT") // DRAFT, FINAL
  documentId           String?
  version              String
  author               String?
  approvedBy           String?
  dateOfIssue          DateTime?
  documentStatus       String?
  reportingPeriodStart DateTime
  reportingPeriodEnd   DateTime
  
  // Manual narrative sections
  progressNarrative    String?
  blockingFactors      String?
  newRisks             String?
  plannedTesting       String?
  metadataJson         Json?
  sectionsJson         Json?
  
  // Auto-generated metrics snapshot (JSON for historical accuracy)
  metricsSnapshot      Json
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([reportType, createdAt])
}
